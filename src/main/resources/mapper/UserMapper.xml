<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.learnflow.domain.user.UserMapper">

    <!-- 권한 목록을 포함한 사용자 ResultMap -->
    <resultMap id="UserResultMap" type="com.learnflow.domain.user.User">
        <id     property="id"        column="id"/>
        <result property="tenantId"  column="tenant_id"/>
        <result property="email"     column="email"/>
        <result property="password"  column="password"/>
        <result property="name"      column="name"/>
        <result property="roleName"  column="role_name"/>
        <result property="active"    column="active"/>
        <collection property="permissions" ofType="string">
            <result column="permission_name"/>
        </collection>
    </resultMap>

    <!-- 공통 사용자 조회 쿼리 (역할·권한 JOIN) -->
    <sql id="selectUserWithPermissions">
        SELECT
            u.id,
            u.tenant_id,
            u.email,
            u.password,
            u.name,
            u.active,
            r.name  AS role_name,
            p.name  AS permission_name
        FROM users u
        JOIN role r ON u.role_id = r.id
        LEFT JOIN role_permission rp ON r.id = rp.role_id
        LEFT JOIN permission p ON rp.permission_id = p.id
        WHERE u.active = TRUE
    </sql>

    <select id="findByIdAndTenant" resultMap="UserResultMap">
        <include refid="selectUserWithPermissions"/>
        AND u.id        = #{id}
        AND u.tenant_id = #{tenantId}
    </select>

    <select id="findByEmailAndTenant" resultMap="UserResultMap">
        <include refid="selectUserWithPermissions"/>
        AND u.email     = #{email}
        AND u.tenant_id = #{tenantId}
    </select>

</mapper>
