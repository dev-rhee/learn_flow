<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.learnflow.domain.enrollment.EnrollmentMapper">

    <resultMap id="EnrollmentResultMap" type="com.learnflow.domain.enrollment.Enrollment">
        <id     property="id"          column="id"/>
        <result property="tenantId"    column="tenant_id"/>
        <result property="courseId"    column="course_id"/>
        <result property="courseTitle" column="course_title"/>
        <result property="userId"      column="user_id"/>
        <result property="userName"    column="user_name"/>
        <result property="status"      column="status"/>
        <result property="enrolledAt"  column="enrolled_at"/>
        <result property="completedAt" column="completed_at"/>
    </resultMap>

    <sql id="selectEnrollment">
        SELECT
            e.id,
            e.tenant_id,
            e.course_id,
            c.title AS course_title,
            e.user_id,
            u.name  AS user_name,
            e.status,
            e.enrolled_at,
            e.completed_at
        FROM enrollment e
        JOIN course c ON e.course_id = c.id
        JOIN users  u ON e.user_id   = u.id
    </sql>

    <select id="findByUserId" resultMap="EnrollmentResultMap">
        <include refid="selectEnrollment"/>
        WHERE e.user_id = #{userId}
        ORDER BY e.enrolled_at DESC
    </select>

    <select id="findByCourseId" resultMap="EnrollmentResultMap">
        <include refid="selectEnrollment"/>
        WHERE e.course_id = #{courseId}
        ORDER BY e.enrolled_at DESC
    </select>

    <select id="findById" resultMap="EnrollmentResultMap">
        <include refid="selectEnrollment"/>
        WHERE e.id = #{id}
    </select>

    <select id="findByUserAndCourse" resultMap="EnrollmentResultMap">
        <include refid="selectEnrollment"/>
        WHERE e.user_id = #{userId} AND e.course_id = #{courseId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO enrollment (tenant_id, course_id, user_id, status)
        VALUES (#{tenantId}, #{courseId}, #{userId}, 'ACTIVE')
    </insert>

    <update id="updateStatus">
        UPDATE enrollment
        SET status       = #{status},
            completed_at = CASE WHEN #{status} = 'COMPLETED' THEN NOW() ELSE completed_at END
        WHERE id = #{id}
    </update>

    <select id="countActiveByCourse" resultType="int">
        SELECT COUNT(*) FROM enrollment
        WHERE course_id = #{courseId} AND status = 'ACTIVE'
    </select>

</mapper>
